import java.util.ArrayList;
import java.util.Collections;

public class KthSmallestElement {

    // Method to find kth smallest element
    public static int findKthSmallest(ArrayList<Integer> list, int k) {
        Collections.sort(list); // sort the list
        return list.get(k - 1);  // kth smallest (1-based index)
    }

    public static void main(String[] args) {
        ArrayList<Integer> numbers = new ArrayList<>();
        numbers.add(7);
        numbers.add(3);
        numbers.add(9);
        numbers.add(1);
        numbers.add(5);

        int k = 3;
        System.out.println("Kth smallest element: " + findKthSmallest(numbers, k));
    }
}
